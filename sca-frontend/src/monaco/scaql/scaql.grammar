@top Query { SelectQuery }

Select { "SELECT" | "select" }
From { "FROM" | "from" }
Comma { "," }
Asterisk { "*" }

GitInfo { "git_info" }
Problems { "problems" }
Arch { "arch" }

SelectQuery { Select FieldList From Project }
FieldList { Asterisk | Field (Comma Field)* }
Field { GitInfo | Problems | Arch }
Project { identifier }

@tokens {
  space { @whitespace+ }
  identifier { $[a-zA-Z0-9_-]+ }
}

@skip { space }
